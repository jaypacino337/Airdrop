{
  "name": "@ustr/engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "cycle:once": "tsx src/cli/run-once.ts",
    "e2e:localnet": "tsx scripts/e2e-localnet.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@supabase/supabase-js": "2.112.3",
    "bs58": "6.0.0",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
