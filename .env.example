# =============================================================================
# Moderna (MRNA) Airdrop Engine — environment
# Copy to .env for local dev, or paste these into Railway → Variables.
# Never commit a filled-in .env. CREATOR_PRIVATE_KEY controls real funds.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# DRY_RUN=true does everything (claim quote, snapshot, allocation, DB writes)
# except signing/sending transactions. Always run one cycle with this on first.
DRY_RUN=true

# --- Helius (RPC + holder indexing) -----------------------------------------
# https://dashboard.helius.dev → API Keys
HELIUS_API_KEY=
# Optional overrides; if unset they are derived from HELIUS_API_KEY.
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxx
# RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com

# --- Supabase ----------------------------------------------------------------
# Project Settings → API. The worker needs the SERVICE ROLE key (server only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The website only ever uses the anon key (read-only, RLS enforced).
SUPABASE_ANON_KEY=

# --- Wallet ------------------------------------------------------------------
# The pump.fun COIN CREATOR wallet: it claims creator fees, buys MRNAx and
# sends the airdrop. Base58 (Phantom "export private key") or a JSON array.
CREATOR_PRIVATE_KEY=

# --- Tokens ------------------------------------------------------------------
# MRNA — the pump.fun coin. Holders of this token receive the airdrop.
PROJECT_TOKEN_MINT=
# MRNAx — the tokenized Moderna stock that gets bought and airdropped.
# Find the current mint on Jupiter / xstocks.com before setting this.
REWARD_TOKEN_MINT=

# --- Cycle schedule ----------------------------------------------------------
CYCLE_INTERVAL_MS=300000          # 5 minutes
RUN_ON_BOOT=true                  # run one cycle immediately at startup

# --- Eligibility & distribution rules ---------------------------------------
MIN_ELIGIBLE_TOKENS=500000        # min MRNA balance to qualify (UI units)
MAX_WALLET_SHARE_BPS=400          # 400 bps = 4% hard cap per wallet per cycle
# Wallets never included in a snapshot (LP pools, CEX, treasury, team...).
# Comma separated. The creator wallet + known burn addresses are added
# automatically.
EXCLUDED_WALLETS=
INCLUDE_FROZEN_ACCOUNTS=false
# Off-curve owners are program accounts: AMM pools, bonding curves, vaults.
# Leave true so liquidity pools never receive the airdrop.
EXCLUDE_OFF_CURVE_OWNERS=true

# --- Claim (pump.fun creator fees) ------------------------------------------
CLAIM_PROVIDER=pumpportal         # pumpportal | onchain | disabled
MIN_CLAIM_LAMPORTS=5000000        # 0.005 SOL — below this, skip the claim
PUMPPORTAL_BASE_URL=https://pumpportal.fun

# --- Buyback (SOL -> MRNAx) --------------------------------------------------
SWAP_PROVIDER=auto                # auto | jupiter | pumpportal | disabled
SWAP_SLIPPAGE_BPS=150             # 1.5%
SOL_RESERVE_LAMPORTS=30000000     # 0.03 SOL kept back for tx fees + rent
MIN_SWAP_LAMPORTS=5000000         # 0.005 SOL — below this, roll over to next cycle
JUPITER_BASE_URL=https://lite-api.jup.ag

# --- Transaction tuning ------------------------------------------------------
PRIORITY_FEE_MICROLAMPORTS=250000
TRANSFERS_PER_TX=6                # recipients bundled into a single transfer tx
MAX_TX_ATTEMPTS=4
CONFIRM_TIMEOUT_MS=90000
MIN_PAYOUT_RAW=1                  # skip payouts smaller than this (raw units)
# How many wallets of each snapshot to keep for the site's holder table.
# `payouts` is always the complete record; this only bounds table growth.
SNAPSHOT_PERSIST_LIMIT=200

# --- API ---------------------------------------------------------------------
# Protects POST /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Comma separated origins allowed to call the API. * allows all.
CORS_ORIGINS=*
