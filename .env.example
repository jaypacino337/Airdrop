# =============================================================================
# Uranium Strategy ($USTR) — engine environment (Solana)
# Copy to .env for local dev, or paste into Railway → Variables.
# Never commit a filled-in .env. TREASURY_SECRET_KEY controls real funds.
#
# Only SUPABASE_* is needed for the engine to DEPLOY. Without the RPC, key and
# mints it boots into standby: /health returns 200 and lists what is missing.
# Fill the rest in afterwards and redeploy to start distributing.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# DRY_RUN=true does everything (fee-vault read, holder snapshot, allocation,
# DB writes) except signing and sending transactions. Always run a few cycles
# with this on first.
DRY_RUN=true

# --- Supabase ----------------------------------------------------------------
# Project Settings → API. The engine needs the SERVICE ROLE key (server only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The website only ever uses the anon key (read-only, RLS enforced).
SUPABASE_ANON_KEY=

# --- Chain (Solana) ----------------------------------------------------------
# A DEDICATED RPC (Helius / Triton / QuickNode). The public endpoint refuses
# the holder scan (getProgramAccounts) on purpose.
SOLANA_RPC_URL=
# Optional: Helius API key → holder snapshots via paginated getTokenAccounts.
HELIUS_API_KEY=
# Optional guard: refuse to start unless the RPC is this cluster
# (mainnet-beta | devnet | testnet | localnet). Checked by genesis hash.
SOLANA_CLUSTER=

# --- Treasury ----------------------------------------------------------------
# The wallet that LAUNCHED the coin on pump.fun (so it can claim the creator
# fees), holds the reward tokens and signs every airdrop. Base58 secret
# (Phantom export) or solana-keygen's JSON byte array. Keep ~0.1 SOL in it for
# fees and the ~0.002 SOL rent of each new recipient token account.
TREASURY_SECRET_KEY=

# --- Tokens ------------------------------------------------------------------
# The USTR mint. Holders of this token receive the airdrop.
PROJECT_TOKEN_MINT=

# What gets airdropped, as SYMBOL:MINT:WEIGHT_BPS entries (weights must total
# 10000). SPL Token and Token-2022 mints both work. One token at 100%:
#   REWARD_TOKENS=URANIUM:<mint>:10000
# Two tokens, half of each buyback each:
#   REWARD_TOKENS=URANIUM:<mint>:5000,USDC:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:5000
REWARD_TOKENS=

# --- Cycle schedule ----------------------------------------------------------
CYCLE_INTERVAL_MS=300000          # 5 minutes
RUN_ON_BOOT=true

# --- Eligibility & distribution rules ---------------------------------------
MIN_ELIGIBLE_TOKENS=500000        # min USTR balance to qualify (UI units)
MAX_WALLET_SHARE_BPS=400          # 400 bps = 4% hard cap per wallet per cycle
# Extra wallets never included (team, CEX...). Comma separated, base58 —
# case-sensitive. Pools, the pump.fun bonding curve, lockers and every other
# PDA are excluded automatically (EXCLUDE_CONTRACT_HOLDERS).
EXCLUDED_WALLETS=
EXCLUDE_CONTRACT_HOLDERS=true

# --- Fee income: pump.fun creator fees ---------------------------------------
# pumpfun: every cycle, claim the treasury's creator fees (bonding curve +
# PumpSwap) through PumpPortal's local-transaction API (signed here, no API
# key). disabled: top the treasury up by hand.
FEE_CLAIM=pumpfun
MIN_CLAIM_LAMPORTS=10000000       # 0.01 SOL — smaller claims roll over

# --- Buyback (SOL -> reward tokens), optional --------------------------------
# disabled (default): distribute whatever reward-token balance the treasury
# holds. pumpportal: buy each reward token with its weight's share of the
# spendable SOL via PumpPortal (pump.fun curve, PumpSwap, Raydium pools).
SWAP_PROVIDER=disabled
SWAP_POOL=auto
SWAP_SLIPPAGE_BPS=1000            # 10%
PUMPPORTAL_PRIORITY_FEE_SOL=0.00005
NATIVE_RESERVE_LAMPORTS=50000000  # 0.05 SOL kept back for fees + account rent
MIN_SWAP_LAMPORTS=10000000        # below this, roll over to next cycle

# --- Transaction tuning ------------------------------------------------------
MIN_PAYOUT_RAW=1                  # skip payouts smaller than this (raw units)
MAX_PAYOUTS_PER_CYCLE=250         # the rest resume next cycle automatically
PAYOUT_BATCH_SIZE=4               # transfers per transaction (max 8)
PRIORITY_MICROLAMPORTS=10000      # compute-unit price for payout transactions
SNAPSHOT_PERSIST_LIMIT=200        # wallets kept per snapshot for the site

# --- API ---------------------------------------------------------------------
# Protects POST /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
CORS_ORIGINS=*
