# =============================================================================
# Uranium Strategy ($USTR) — engine environment
# Copy to .env for local dev, or paste into Railway → Variables.
# Never commit a filled-in .env. TREASURY_PRIVATE_KEY controls real funds.
#
# Only SUPABASE_* is needed for the engine to DEPLOY. Without the RPC, key and
# token addresses it boots into standby: /health returns 200 and lists what is
# missing. Fill the rest in afterwards and redeploy to start distributing.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# DRY_RUN=true does everything (holder index, allocation, DB writes) except
# signing and sending transactions. Always run a few cycles with this on first.
DRY_RUN=true

# --- Supabase ----------------------------------------------------------------
# Project Settings → API. The engine needs the SERVICE ROLE key (server only).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The website only ever uses the anon key (read-only, RLS enforced).
SUPABASE_ANON_KEY=

# --- Chain (Robinhood Chain / any EVM) ---------------------------------------
EVM_RPC_URL=
# Optional guard: refuse to start if the RPC reports a different chain id.
CHAIN_ID=0

# --- Treasury ----------------------------------------------------------------
# The wallet that receives Pons creator fees, holds the uranium tokens and
# sends the airdrop. 32-byte hex private key. Fund it with a little native
# token for gas.
TREASURY_PRIVATE_KEY=

# --- Tokens ------------------------------------------------------------------
# The USTR token launched on Pons. Holders of this token receive the airdrop.
PROJECT_TOKEN_ADDRESS=
# Block it was deployed at — where the holder index starts scanning.
PROJECT_TOKEN_DEPLOY_BLOCK=0

# What gets airdropped, as SYMBOL:0xADDRESS:WEIGHT_BPS entries (weights must
# total 10000). One uranium token at 100%:
#   REWARD_TOKENS=xU3O8:0x...:10000
# NOTE: xU3O8 transfers are whitelist-gated by its issuer. If arbitrary-holder
# transfers are not possible, use an unrestricted uranium proxy (e.g. the NNE
# stock token) and keep xU3O8 as a treasury reserve asset instead.
REWARD_TOKENS=

# --- Cycle schedule ----------------------------------------------------------
CYCLE_INTERVAL_MS=300000          # 5 minutes
RUN_ON_BOOT=true

# --- Eligibility & distribution rules ---------------------------------------
MIN_ELIGIBLE_TOKENS=500000        # min USTR balance to qualify (UI units)
MAX_WALLET_SHARE_BPS=400          # 400 bps = 4% hard cap per wallet per cycle
# Extra wallets never included (team, CEX...). Pools/routers/lockers are
# excluded automatically because they are contracts.
EXCLUDED_WALLETS=
EXCLUDE_CONTRACT_HOLDERS=true

# --- Buyback (native -> uranium tokens), optional ----------------------------
# disabled (default): the engine distributes whatever reward-token balance the
# treasury holds; acquiring it stays a visible treasury operation.
# univ2: swap the treasury's spendable native through a V2-compatible router.
SWAP_PROVIDER=disabled
ROUTER_ADDRESS=
WRAPPED_NATIVE_ADDRESS=
SWAP_SLIPPAGE_BPS=300
NATIVE_RESERVE_WEI=20000000000000000   # 0.02 kept back for gas
MIN_SWAP_WEI=5000000000000000          # below this, roll over to next cycle

# --- Transaction & indexing tuning -------------------------------------------
MIN_PAYOUT_RAW=1                  # skip payouts smaller than this (raw units)
MAX_PAYOUTS_PER_CYCLE=250         # the rest resume next cycle automatically
TX_TIMEOUT_MS=120000
LOG_SCAN_CHUNK=5000               # blocks per eth_getLogs while indexing
SNAPSHOT_PERSIST_LIMIT=200        # wallets kept per snapshot for the site

# --- API ---------------------------------------------------------------------
# Protects POST /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
CORS_ORIGINS=*
