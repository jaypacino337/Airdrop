# =============================================================================
# Website environment (Railway → the "web" service → Variables)
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# set them before you deploy, and redeploy after you change one.
# =============================================================================

# --- Read-only ledger access (server side only, never sent to the browser) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# --- Branding & on-chain links ----------------------------------------------
NEXT_PUBLIC_TOKEN_SYMBOL=STRATEGY
NEXT_PUBLIC_PROJECT_TOKEN_MINT=

# Decimals are used purely for formatting. pump.fun coins are 6.
NEXT_PUBLIC_PROJECT_TOKEN_DECIMALS=6

# Reward tokens as SYMBOL:MINT:DECIMALS:WEIGHT_BPS — mirror REWARD_TOKENS on
# the worker. Weights are shown on the site as the split (e.g. 50/50).
NEXT_PUBLIC_REWARD_TOKENS=WLFI:<wlfi_mint>:6:5000,TRUMP:<trump_mint>:6:5000

# --- Must mirror the worker's settings, or the site will describe the wrong rules
NEXT_PUBLIC_CYCLE_INTERVAL_MS=300000
NEXT_PUBLIC_MIN_ELIGIBLE_TOKENS=500000
NEXT_PUBLIC_MAX_WALLET_SHARE_BPS=400

# --- Social links (optional; hidden when empty) ------------------------------
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PUMPFUN_URL=
