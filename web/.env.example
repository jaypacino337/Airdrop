# =============================================================================
# Website environment (Vercel / Railway → the "web" service → Variables)
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
# set them before deploying, and redeploy after changing one.
# =============================================================================

# --- Read-only ledger access (server side only, never sent to the browser) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# --- Branding & on-chain links ----------------------------------------------
NEXT_PUBLIC_TOKEN_SYMBOL=USTR
# The USTR mint (base58, case-sensitive). Also drives the default buy link.
NEXT_PUBLIC_PROJECT_TOKEN_MINT=
NEXT_PUBLIC_PROJECT_TOKEN_DECIMALS=6
NEXT_PUBLIC_TREASURY_ADDRESS=

# Reward tokens as SYMBOL:MINT:DECIMALS:WEIGHT_BPS — mirror the engine's
# REWARD_TOKENS (plus decimals). Example: URANIUM:<mint>:6:10000
NEXT_PUBLIC_REWARD_TOKENS=

# mainnet-beta (default) or devnet — adds ?cluster= to explorer links.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Explorer base URL, no trailing slash. Defaults to https://solscan.io.
NEXT_PUBLIC_EXPLORER_URL=

# --- Must mirror the engine's settings, or the site describes the wrong rules
NEXT_PUBLIC_CYCLE_INTERVAL_MS=300000
NEXT_PUBLIC_MIN_ELIGIBLE_TOKENS=500000
NEXT_PUBLIC_MAX_WALLET_SHARE_BPS=400

# --- Links (optional; hidden when empty) -------------------------------------
# Defaults to https://pump.fun/coin/<mint> once the mint is set.
NEXT_PUBLIC_PUMP_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
